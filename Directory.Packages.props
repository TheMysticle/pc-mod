<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="LegatoBS" Version="0.1.0-bs1.45.1" />
    <PackageVersion Include="protobuf-net" Version="3.2.30" />
    <PackageVersion Include="protobuf-net.Core" Version="3.2.30" />
    <!-- Pinned to exactly this version because its net461 build's own AssemblyVersion happens to be
         4.0.3.0 (confirmed via monodis), matching the exact strong-name the runtime requests.
         Other versions of this package build a DLL with a different AssemblyVersion and won't load. -->
    <PackageVersion Include="System.Buffers" Version="4.5.1" />
    <PackageVersion Include="BeatSaberModdingTools.Tasks" Version="2.0.0-beta4" />
    <PackageVersion Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" />
  </ItemGroup>
</Project>
